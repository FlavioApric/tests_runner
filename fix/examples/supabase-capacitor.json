{
  "baseBranch": "main",
  "remote": "origin",
  "repo": "your-org/your-app",
  "runnerRepo": "your-org/your-runner",
  "branchPrefix": "fix/",
  "worktreePrefix": "wt-",
  "cardDir": "docs/fix/bugs",
  "cardTemplate": "docs/fix/templates/BUG.md",
  "logFiles": ["docs/fix/LOG.md", "qa/bug-list.md"],
  "idPattern": "^BUG-[A-Za-z0-9_-]{1,36}$",
  "idExample": "BUG-F20260101-1",
  "slugPattern": "^[a-z0-9-]{2,40}$",
  "deliveryOrder": ["none", "web", "edge", "migration", "native"],
  "blockingTypes": ["native"],
  "deliveryRules": [
    { "type": "native", "path": "^app/(android|ios)/" },
    { "type": "native", "path": "^app/capacitor\\.config\\." },
    { "type": "migration", "path": "^supabase/migrations/" },
    { "type": "edge", "path": "^supabase/functions/" },
    { "type": "web", "path": "^app/(src|public|index\\.html|vite\\.config|tailwind|postcss|tsconfig)" },
    { "type": "web", "path": "^app/(package\\.json|pnpm-lock\\.yaml)$" }
  ],
  "nativeDeps": { "manifest": "app/package.json", "pattern": "^@capacitor/", "type": "native" },
  "checks": [
    { "name": "app lint", "cmd": "npm run lint", "cwd": "app", "paths": ["^app/"] },
    { "name": "app build", "cmd": "npm run build", "cwd": "app", "paths": ["^app/"] },
    { "name": "function unit tests", "cmd": "npm run test:functions", "paths": ["^supabase/functions/", "^tests/functions/"] },
    { "name": "migration lint", "cmd": "npm run lint:migrations", "paths": ["^supabase/migrations/"] },
    { "name": "sql tests (local stack)", "cmd": "npm run test:sql", "kinds": ["migration"], "paths": ["^tests/sql/"], "stack": true },
    { "name": "edge tests (local stack)", "cmd": "npm run test:edge", "kinds": ["edge"], "paths": ["^tests/edge/"], "stack": true }
  ],
  "testPaths": ["^tests/", "^playwright-tests/", "^maestro/flows/", "^app/src/.*\\.(test|spec)\\."],
  "resultFiles": ["^qa/evidence/", "^test-results/", "^playwright-report/", "^graphify-out/", "^\\.fix-batch/"],
  "requirementIdPattern": "R\\d+-\\d+",
  "testsBranch": "qa/coverage",
  "featureChecks": [
    { "label": "decision row", "path": "^docs/DECISIONS\\.md$" },
    { "label": "spec or design text updated", "path": "^docs/(spec|design)/" }
  ],
  "ownerActions": {
    "none": "No delivery: tests, docs or scripts only.",
    "web": "Owner: approve the runner workflow \"deploy-web\" with pr={pr}. Apps that load the web bundle over the air get it after the build (open the app twice).",
    "edge": "Owner: approve the runner workflow \"deploy-functions\" for the changed functions. Web part, if any: \"deploy-web\" with pr={pr}.",
    "migration": "Owner: approve the runner workflow \"ship-migration\" with the version. Then \"deploy-functions\" and \"deploy-web\" (pr={pr}), in that order.",
    "native": "NOT over the air. A store build is needed (Android and iOS build workflows). Tell the owner before spending time."
  },
  "readOnlyChecks": [
    "gh workflow run verify.yml --repo {runnerRepo} -f repo={repo} -f ref={branch}",
    "gh workflow run verify-release.yml --repo {runnerRepo} -f sha=<merged sha>"
  ],
  "briefDir": ".fix-batch"
}
