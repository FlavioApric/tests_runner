{
 "name": "tests-runner-test-plan",
 "version": "1.0.0",
 "private": true,
 "description": "Generic test-plan pipeline: code -> graph -> research -> requirements -> browser cases -> compiled Playwright / Maestro plans -> qa-fleet units",
 "type": "module",
 "license": "MIT",
 "engines": {
  "node": ">=20.11"
 },
 "scripts": {
  "test": "node --test \"test/*.test.mjs\"",
  "e2e": "playwright test -c examples/tiny-app/playwright.config.mjs",
  "example:flow": "node qa-pack/runners/pack.mjs flow --project examples/tiny-app",
  "example:validate": "node qa-pack/runners/pack.mjs validate --strict --project examples/tiny-app"
 },
 "devDependencies": {
  "@playwright/test": "1.61.1"
 }
}
